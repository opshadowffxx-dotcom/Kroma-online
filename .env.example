# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Cloud Firestore & Firebase Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to true only for local offline demo/development mode with mock data
# Production/live mode defaults to false (100% real Firebase Firestore & Auth)
VITE_USE_MOCK_DATA=false

# Cloudflare R2 Object Storage (Server-Only Configuration - NEVER prefix with VITE_)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=testmedia
R2_PUBLIC_URL=https://pub-YOUR_R2_PUBLIC_URL_KEY.r2.dev

# Firebase Admin SDK (Server-Side Automated Jobs / Netlify Background Functions - NEVER prefix with VITE_)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Analytics 4 Data API (Server-Only Configuration - NEVER prefix with VITE_)
# Required for server-side queries of Top Countries / Geo Reach reports (kroma_reach event)
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=ga4-service-account@your-gcp-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Fixed KROMA analytics epoch used by the All range (defaults to this date in code)
GA4_ANALYTICS_START_DATE=2026-08-01

# Client-side GA4 Measurement ID for event tracking
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX


